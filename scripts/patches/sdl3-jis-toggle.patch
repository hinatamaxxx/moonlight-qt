+static bool WIN_RawKeyboardIsKeyDown(const RAWKEYBOARD *rawkeyboard)
+{
+    // Japanese Hankaku/Zenkaku can report RI_KEY_MAKE for both transitions.
+    // Its DBE messages are reversed: WM_KEYUP is the physical press, and
+    // WM_KEYDOWN is the physical release. Using Flags alone leaves it held.
+    if (rawkeyboard->MakeCode == 0x29 &&
+        (rawkeyboard->VKey == 0xf3 /* VK_DBE_SBCSCHAR */ ||
+         rawkeyboard->VKey == 0xf4 /* VK_DBE_DBCSCHAR */)) {
+        if (rawkeyboard->Message == WM_KEYUP || rawkeyboard->Message == WM_SYSKEYUP) {
+            return true;
+        }
+        if (rawkeyboard->Message == WM_KEYDOWN || rawkeyboard->Message == WM_SYSKEYDOWN) {
+            return false;
+        }
+    }
+    return !(rawkeyboard->Flags & RI_KEY_BREAK);
+}
